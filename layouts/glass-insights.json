{
  "id": "root",
  "link_handlers": [
    "markdown-browser",
    "web-browser"
  ],
  "cloned_from": {
    "name": "glass",
    "version": "0.1.16"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "stack",
          "children": [
            {
              "id": "lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "space-folders-next"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "rail-next",
                    "props": {
                      "view": "agents"
                    }
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                }
              ]
            },
            {
              "id": "inbox",
              "type": "block",
              "content": {
                "mod": "t3-inbox",
                "props": {
                  "newMenu": "t3-new-menu",
                  "picker": "t3-picker"
                }
              }
            }
          ],
          "active": "lists"
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "better-sidebar-rail",
            "props": {
              "view": "footer"
            }
          },
          "size": {
            "px": 28
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "children": [
            {
              "id": "where",
              "type": "block",
              "content": {
                "mod": "where"
              },
              "size": {
                "px": 150
              },
              "window_drag": true
            },
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "better-tabs",
                "props": {
                  "rememberPanels": {
                    "container": "panel",
                    "stack": "panel-body"
                  },
                  "buttons": [
                    {
                      "id": "files",
                      "label": "Files",
                      "icon": "file",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "label": "Changes",
                      "icon": "changes",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "changes"
                      }
                    },
                    {
                      "id": "markdown",
                      "label": "Markdown",
                      "icon": "mods/markdown-browser/markdown.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "markdown"
                      }
                    },
                    {
                      "id": "web",
                      "label": "Web",
                      "icon": "mods/web-browser/web.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "web"
                      }
                    },
                    {
                      "id": "prs",
                      "label": "PRs",
                      "icon": "mods/branch-pr/icons/pull-request.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "pull-requests"
                      }
                    },
                    {
                      "id": "ci",
                      "label": "CI",
                      "icon": "mods/ci-dash/ci.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "ci"
                      }
                    },
                    {
                      "id": "prompts",
                      "label": "Timeline",
                      "icon": "mods/over9k-prompts/timeline.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "prompts"
                      }
                    },
                    {
                      "id": "insights",
                      "label": "Insights",
                      "icon": "mods/insights/insights.svg",
                      "group": "tabs",
                      "action": {
                        "type": "mod-tab",
                        "mod": "insights",
                        "name": "Insights"
                      }
                    }
                  ]
                }
              },
              "size": {
                "weight": 1
              },
              "window_drag": true
            },
            {
              "id": "panel-toggle",
              "type": "block",
              "content": {
                "mod": "better-sidebar-rail",
                "props": {
                  "view": "panel-toggle"
                }
              },
              "size": {
                "px": 36
              }
            }
          ],
          "size": {
            "px": 42
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "better-changes"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "#07091030",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 12,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "better-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "better-changes"
                      }
                    },
                    {
                      "id": "markdown",
                      "type": "block",
                      "content": {
                        "mod": "markdown-browser"
                      }
                    },
                    {
                      "id": "web",
                      "type": "block",
                      "content": {
                        "mod": "web-browser"
                      }
                    },
                    {
                      "id": "pull-requests",
                      "type": "block",
                      "content": {
                        "mod": "branch-pr"
                      }
                    },
                    {
                      "id": "ci",
                      "type": "block",
                      "content": {
                        "mod": "ci-dash"
                      }
                    },
                    {
                      "id": "prompts",
                      "type": "block",
                      "content": {
                        "mod": "over9k-prompts"
                      }
                    }
                  ],
                  "active": "pull-requests"
                }
              ],
              "size": {
                "px": 380
              },
              "min": 280,
              "max": 900,
              "background": "#07091030",
              "radius": 10,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          },
          "hidden": true
        },
        {
          "id": "usage-limits",
          "type": "block",
          "content": {
            "mod": "usage-limits"
          },
          "size": {
            "px": 28
          }
        },
        {
          "id": "tui-prefix-daemon",
          "type": "block",
          "content": {
            "mod": "tui-prefix",
            "props": {
              "daemon": true
            }
          },
          "size": {
            "px": 0
          }
        },
        {
          "id": "agent-names-daemon",
          "type": "block",
          "content": {
            "mod": "agent-names"
          },
          "size": {
            "px": 0
          }
        },
        {
          "id": "agent-resume-daemon",
          "type": "block",
          "content": {
            "mod": "agent-resume"
          },
          "size": {
            "px": 0
          }
        },
        {
          "id": "quota-resume-daemon",
          "type": "block",
          "content": {
            "mod": "quota-resume"
          },
          "size": {
            "px": 0
          }
        },
        {
          "id": "goto-daemon",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "goto",
            "props": {
              "daemon": true
            }
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "gradient": [
      "#13182696",
      "#1c142896"
    ],
    "angle": 135
  },
  "colors": {
    "accent": "#9ad0ff",
    "background": "#0a0c1400",
    "border": "#ffffff22",
    "canvas": "#00000000",
    "chrome": "#090c1412",
    "popover": "#1d1a2b",
    "raised": "#252d4640"
  },
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "floating": [
    {
      "id": "better-alerts",
      "content": {
        "mod": "better-alerts"
      },
      "edge": "bottom",
      "align": "end"
    }
  ],
  "theme": "graphite",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "window_blur": true
}
