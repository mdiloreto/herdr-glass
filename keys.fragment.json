{
  "$comment": "Recommended Herdr App keybindings for glass. global carries the ctrl-space prefix map; scripts/install.sh merges this file into keys.json add-only and never overwrites an existing binding.",
  "global": {
    "ctrl-space ctrl-space": "send:\u0000",
    "ctrl-space %": "pane.split:right",
    "ctrl-space shift-5": "pane.split:right",
    "ctrl-space v": "pane.split:right",
    "ctrl-space \"": "pane.split:down",
    "ctrl-space shift-'": "pane.split:down",
    "ctrl-space -": "pane.split:down",
    "ctrl-space x": "pane.close",
    "ctrl-space z": "pane.zoom",
    "ctrl-space h": "pane.go:left",
    "ctrl-space j": "pane.go:down",
    "ctrl-space k": "pane.go:up",
    "ctrl-space l": "pane.go:right",
    "ctrl-space H": "pane.swap:left",
    "ctrl-space J": "pane.swap:down",
    "ctrl-space K": "pane.swap:up",
    "ctrl-space L": "pane.swap:right",
    "ctrl-space shift-h": "pane.swap:left",
    "ctrl-space shift-j": "pane.swap:down",
    "ctrl-space shift-k": "pane.swap:up",
    "ctrl-space shift-l": "pane.swap:right",
    "ctrl-space ctrl-h": "tui-prefix.move-pane:left",
    "ctrl-space ctrl-l": "tui-prefix.move-pane:right",
    "ctrl-space c": "tab.new",
    "ctrl-space &": "tab.close",
    "ctrl-space shift-7": "tab.close",
    "ctrl-space X": "tab.close",
    "ctrl-space shift-x": "tab.close",
    "ctrl-space ,": "tab.rename",
    "ctrl-space T": "tab.rename",
    "ctrl-space shift-t": "tab.rename",
    "ctrl-space ]": "tab.next",
    "ctrl-space [": "tab.prev",
    "ctrl-space n": "tab.next",
    "ctrl-space p": "tab.prev",
    "ctrl-space 1": "tab.select:1",
    "ctrl-space 2": "tab.select:2",
    "ctrl-space 3": "tab.select:3",
    "ctrl-space 4": "tab.select:4",
    "ctrl-space 5": "tab.select:5",
    "ctrl-space 6": "tab.select:6",
    "ctrl-space 7": "tab.select:7",
    "ctrl-space 8": "tab.select:8",
    "ctrl-space 9": "tab.select:9",
    "ctrl-space alt-n": "space.new",
    "ctrl-space N": {
      "command": "space.new",
      "args": {
        "folder": ""
      }
    },
    "ctrl-space shift-n": {
      "command": "space.new",
      "args": {
        "folder": ""
      }
    },
    "ctrl-space alt-g": "mod.open:worktree",
    "ctrl-space w": "mod.open:tui-spaces",
    "ctrl-space r": "mod.open:recap",
    "ctrl-space space": "mod.open:t3-picker",
    "ctrl-space alt-t": "mod.open:tui-goto",
    "ctrl-space i": "tui-prefix.toggle-inbox",
    "ctrl-space S": "t3-inbox.settle",
    "ctrl-space shift-s": "t3-inbox.settle",
    "ctrl-space W": "space.rename",
    "ctrl-space shift-w": "space.rename",
    "ctrl-space D": "space.close",
    "ctrl-space shift-d": "space.close",
    "ctrl-space up": "tui-prefix.prev-agent",
    "ctrl-space down": "tui-prefix.next-agent",
    "ctrl-space ctrl-up": "tui-prefix.prev-agent",
    "ctrl-space ctrl-down": "tui-prefix.next-agent",
    "ctrl-space b": "tui-prefix.toggle-sidebar",
    "ctrl-space f": "better-tabs.button:files",
    "ctrl-space d": "better-tabs.button:markdown",
    "ctrl-space .": "mod.open:markdown-browser",
    "ctrl-space B": "better-tabs.button:web",
    "ctrl-space shift-b": "better-tabs.button:web",
    "ctrl-space G": "better-tabs.button:changes",
    "ctrl-space shift-g": "better-tabs.button:changes",
    "ctrl-space o": "better-tabs.button:prs",
    "ctrl-space O": "better-sidebar-rail.toggle-panel",
    "ctrl-space shift-o": "better-sidebar-rail.toggle-panel",
    "ctrl-space P": "better-tabs.button:prs",
    "ctrl-space shift-p": "better-tabs.button:prs",
    "ctrl-space I": "better-tabs.button:insights",
    "ctrl-space shift-i": "better-tabs.button:insights",
    "ctrl-space alt-o": "tui-prefix.github-prs",
    "ctrl-space alt-p": "tui-prefix.agent-pr",
    "ctrl-space s": "app.settings",
    "ctrl-space ?": "mod.open:tui-prefix",
    "ctrl-space shift-/": "mod.open:tui-prefix",
    "ctrl-space /": "app.help",
    "ctrl-space q": "window.minimize"
  },
  "layout:glass": {
    "alt-down": "space-folders-next.next",
    "alt-up": "space-folders-next.prev",
    "ctrl-shift-pagedown": "space-folders-next.next",
    "ctrl-shift-pageup": "space-folders-next.prev",
    "ctrl-space space": "mod.open:goto",
    "ctrl-shift-k": "mod.open:goto",
    "ctrl-space m": "goto.move-tab",
    "ctrl-space M": "goto.move-space",
    "ctrl-space shift-m": "goto.move-space",
    "cmd-shift-b": "better-tabs.button:web",
    "ctrl-space B": "better-tabs.button:web",
    "ctrl-space shift-b": "better-tabs.button:web"
  },
  "layout:glass-insights": {
    "alt-down": "space-folders-next.next",
    "alt-up": "space-folders-next.prev",
    "ctrl-shift-pagedown": "space-folders-next.next",
    "ctrl-shift-pageup": "space-folders-next.prev",
    "ctrl-space space": "mod.open:goto",
    "ctrl-shift-k": "mod.open:goto",
    "ctrl-space m": "goto.move-tab",
    "ctrl-space M": "goto.move-space",
    "ctrl-space shift-m": "goto.move-space",
    "cmd-shift-b": "better-tabs.button:web",
    "ctrl-space B": "better-tabs.button:web",
    "ctrl-space shift-b": "better-tabs.button:web"
  },
  "mod:tui-prefix": {
    "ctrl-space": "tui-prefix.send-prefix"
  },
  "mod:markdown-browser": {
    "cmd-shift-o": "markdown-browser.open",
    "ctrl-shift-o": "markdown-browser.open"
  },
  "terminal": {
    "ctrl-n": "terminal",
    "ctrl-left": "terminal",
    "ctrl-right": "terminal"
  }
}
